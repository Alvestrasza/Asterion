{
  "name": "asterion-tamagotchi",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A multi-user, server-authoritative Tamagotchi service with eight selectable companions.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "check": "prisma generate && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.9.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.9.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0"
}
