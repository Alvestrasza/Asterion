generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  pet            Pet?
  access         UserAccess?
  socialProfile  SocialProfile?
  friendshipsLeft Friendship[] @relation("FriendLeft")
  friendshipsRight Friendship[] @relation("FriendRight")
  chatIdentity ChatIdentity?
  chatBudget ChatBudget?
  chatReads ChatRead[]
}

model SocialProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  username String? @unique @db.VarChar(32)
  usernameDisplay String? @db.VarChar(32)
  friendCodeHash String? @unique @db.VarChar(64)
  discoverable Boolean @default(false)
  lastSeenAt DateTime?
  windowStartedAt DateTime @default(now())
  windowCount Int @default(0)
  requestDay DateTime @default(now())
  requestCount Int @default(0)
}

model Friendship {
  id String @id @default(cuid())
  leftId String
  rightId String
  left User @relation("FriendLeft", fields: [leftId], references: [id], onDelete: Cascade)
  right User @relation("FriendRight", fields: [rightId], references: [id], onDelete: Cascade)
  requestedBy String
  status String @default("pending") @db.VarChar(16)
  leftBlocked Boolean @default(false)
  rightBlocked Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  chatMessages ChatMessage[]
  chatReads ChatRead[]
  @@unique([leftId, rightId])
  @@index([rightId, status])
}

// Immutable public keys and an opaque, client-encrypted recovery bundle only.
model ChatIdentity {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String @unique @db.VarChar(64)
  registration Json
  createdAt DateTime @default(now())
}

model ChatBudget {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStartedAt DateTime @default(now())
  windowCount Int @default(0)
  sendCount Int @default(0)
  registrationCount Int @default(0)
  dayStartedAt DateTime @default(now())
  daySendCount Int @default(0)
}

model ChatMessage {
  sequence BigInt @id @default(autoincrement())
  id String @unique @db.VarChar(36)
  friendshipId String
  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  senderId String
  recipientId String
  envelope Json
  digest String @db.VarChar(128)
  createdAt DateTime @default(now())
  @@index([friendshipId, sequence])
  @@index([recipientId, friendshipId, sequence])
}

model ChatRead {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendshipId String
  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sequence BigInt @default(0)
  @@id([userId, friendshipId])
}

enum AccessRole {
  none
  member
  admin
}

enum AccessSyncStatus {
  pending
  applied
  failed
  blocked
}

// Desired state and its durable, coalesced synchronization job share one row.
model UserAccess {
  userId         String           @id
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer         String           @db.VarChar(512)
  subject        String           @db.VarChar(255)
  desiredRole    AccessRole       @default(none)
  effectiveRole  AccessRole       @default(none)
  revision       Int              @default(1)
  syncedRevision Int              @default(0)
  syncStatus     AccessSyncStatus @default(pending)
  attempts       Int              @default(0)
  retryAt        DateTime?
  checkedAt      DateTime?
  errorCode      String?          @db.VarChar(64)
  careWindowStartedAt DateTime?
  careWindowCount Int             @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([issuer, subject])
  @@index([syncStatus, retryAt])
  @@index([syncStatus, checkedAt])
}

// This tombstone survives user deletion, preventing accidental re-bootstrap.
model AccessBootstrap {
  id         String   @id
  userId     String
  consumedAt DateTime @default(now())
}

// Metadata only: no identity-provider tokens, free text, diary data, or keys.
model AccessAudit {
  id            String      @id @default(cuid())
  actorId       String?
  targetId      String
  action        String      @db.VarChar(40)
  desiredRole   AccessRole
  effectiveRole AccessRole
  revision      Int
  outcome       String      @db.VarChar(64)
  occurredAt    DateTime    @default(now())

  @@index([targetId, occurredAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Pet {
  id             String     @id @default(cuid())
  ownerId        String     @unique
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           String     @default("asterion") @db.VarChar(32)
  bornAt         DateTime   @default(now())
  lastAdvancedAt DateTime   @default(now())
  satiety        Float      @default(76)
  energy         Float      @default(82)
  joy            Float      @default(74)
  bond           Float      @default(24)
  sleeping       Boolean    @default(false)
  level          Int        @default(1)
  xp             Int        @default(0)
  interactions   Int        @default(0)
  version        Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  events         PetEvent[]
}

model PetEvent {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  requestId  String   @db.VarChar(64)
  action     String   @db.VarChar(32)
  message    String   @db.VarChar(320)
  animation  String   @db.VarChar(32)
  accepted   Boolean  @default(true)
  occurredAt DateTime @default(now())

  @@unique([petId, requestId])
  @@index([petId, occurredAt(sort: Desc)])
}

// Metadata-only tombstones prevent replaying identity attribute writes after uncertain outcomes.
// Deliberately no user foreign key: deleting an app account must not authorize a second write.
model IdentityStorageWrite {
  userId String @db.VarChar(128)
  issuer String @db.VarChar(512)
  subject String @db.VarChar(255)
  attribute String @db.VarChar(40)
  digest String @db.VarChar(64)
  confirmed Boolean @default(false)
  friendCodeHash String? @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([issuer, subject, attribute])
}
