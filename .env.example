# PostgreSQL database dedicated to one Asterion environment.
DATABASE_URL="postgresql://asterion_app:replace-me@db.example.invalid:5432/asterion_dev?schema=public"

# Auth.js and Keycloak OIDC. Never commit real values.
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_TRUST_HOST="true"
AUTH_KEYCLOAK_ID="asterion-dev"
AUTH_KEYCLOAK_SECRET="replace-me"
AUTH_KEYCLOAK_ISSUER="https://identity.example.invalid/realms/example"
# Optional in development; public deployments require an explicit HTTPS admin origin.
# ASTERION_KEYCLOAK_ADMIN_ORIGIN="https://identity-admin.example.invalid"
# Phase 1 uses standard Keycloak user attributes and a SEPARATE service client.
# No Keycloak extension. Never reuse role-sync grants. See CHAT-RECOVERY-PHASES.
# ASTERION_KEYCLOAK_STORAGE_CLIENT_ID="replace-separate-storage-client-id"
# ASTERION_KEYCLOAK_STORAGE_CLIENT_SECRET="replace-me"
# Absolute protected file: one 32-byte random key in canonical base64url (43 chars).
# Keep the same key on both application nodes, NEVER in Keycloak or either DB.
# ASTERION_CHAT_RECOVERY_KEY_FILE="/etc/asterion-dev/chat-recovery.key"

# Public authentication uses application-owned permissions, not an environment
# role allowlist. Copy the complete protected template from deploy/public/.
ASTERION_DEPLOYMENT_MODE="unconfigured"

# Temporary shared-user bypass for private-network testing only. Keep false for
# normal multi-user and every externally reachable deployment.
ASTERION_INTERNAL_TEST_MODE="false"

# Asterion's high-poly 3D presentation. Keep disabled until representative
# mobile performance has been accepted for the release.
NEXT_PUBLIC_ASTERION_3D_ENABLED="false"

# Runtime listener. Keep the app bound to loopback behind the reverse proxy.
HOSTNAME="127.0.0.1"
PORT="3011"
