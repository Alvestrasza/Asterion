# PostgreSQL database dedicated to one Asterion environment.
DATABASE_URL="postgresql://asterion_app:replace-me@db.example.invalid:5432/asterion_dev?schema=public"

# Auth.js and Keycloak OIDC. Never commit real values.
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_TRUST_HOST="true"
AUTH_KEYCLOAK_ID="asterion-dev"
AUTH_KEYCLOAK_SECRET="replace-me"
AUTH_KEYCLOAK_ISSUER="https://identity.example.invalid/realms/example"

# Required Keycloak realm/client role or group. Production fails closed if unset.
ASTERION_REQUIRED_ROLE="asterion-dev-users"

# Temporary shared-user bypass for private-network testing only. Keep false for
# normal multi-user and every externally reachable deployment.
ASTERION_INTERNAL_TEST_MODE="false"

# Runtime listener. Keep the app bound to loopback behind the reverse proxy.
HOSTNAME="127.0.0.1"
PORT="3011"
