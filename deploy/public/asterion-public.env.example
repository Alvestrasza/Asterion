# Protected runtime configuration; no shell expansion. Keep one KEY=value per line.
# Replace all placeholders. Keep this environment separate from internal testing.
NODE_ENV=production
ASTERION_DEPLOYMENT_MODE=public
ASTERION_INTERNAL_TEST_MODE=false
HOSTNAME=127.0.0.1
PORT=3012
DATABASE_URL=postgresql://replace-public-runtime-role:replace-password@db.example.invalid:5432/replace-public-database?schema=public
# Optional: true requires a literal IPv4 database host; false/unset permits DNS.
# ASTERION_DATABASE_IPV4_ONLY=true
AUTH_SECRET=replace-with-at-least-32-random-characters-shared-between-public-nodes
AUTH_TRUST_HOST=true
AUTH_URL=https://canonical.example.invalid
ASTERION_ALTERNATE_ORIGIN=https://alternate.example.invalid
ASTERION_TRUSTED_PROXY_IPS=replace-with-exact-comma-separated-IPv4-load-balancer-peer-addresses
# Backend HTTPS on shared IPv4 port 443; do not copy keys into a release.
ASTERION_BACKEND_TLS_CERT_FILE=replace-with-reviewed-absolute-server-certificate-path
ASTERION_BACKEND_TLS_KEY_FILE=replace-with-reviewed-absolute-private-key-path
ASTERION_BACKEND_TLS_CA_FILE=replace-with-reviewed-absolute-trusted-CA-bundle-path
# Certificate DNS identity for the LB and local verified checks, not the HTTP Host.
# This may differ between nodes; AUTH_URL remains identical on both nodes.
ASTERION_BACKEND_TLS_SERVER_NAME=replace-with-verified-backend-certificate-DNS-name
AUTH_KEYCLOAK_ID=replace-public-oidc-client-id
AUTH_KEYCLOAK_SECRET=replace-public-oidc-client-secret
AUTH_KEYCLOAK_ISSUER=https://identity.example.invalid/realms/replace-public-realm
# Exact HTTPS origin only: no /admin, realm path, or trailing slash.
ASTERION_KEYCLOAK_ADMIN_ORIGIN=https://identity-admin.example.invalid
# Phase 1: standard user attributes, separate client with reviewed user-management rights.
# No Keycloak extension. These are NOT admin-sync credentials.
# Enable only after isolated Keycloak/PostgreSQL acceptance. See docs/CHAT-RECOVERY-PHASES.md.
# ASTERION_KEYCLOAK_STORAGE_CLIENT_ID=replace-separate-storage-client-id
# ASTERION_KEYCLOAK_STORAGE_CLIENT_SECRET=replace-storage-client-secret
# A protected absolute file containing one random 32-byte key in base64url (43 chars).
# Shared by application nodes only; NEVER store in Keycloak, either DB or a release.
# ASTERION_CHAT_RECOVERY_KEY_FILE=/etc/asterion-public/chat-recovery.key
# When using chat-recovery.conf.example, leave the preceding key-path line
# commented: systemd supplies its private runtime path through the drop-in.
# Install that drop-in only with the complete reviewed chat upgrade.
# Extend Node's trust at startup if the private admin endpoint uses a system-trusted private CA.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ASTERION_KEYCLOAK_ADMIN_CLIENT_ID=replace-separate-permission-sync-client-id
ASTERION_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-permission-sync-client-secret
ASTERION_KEYCLOAK_CLIENT_UUID=replace-public-oidc-client-internal-uuid
ASTERION_MEMBER_ROLE=replace-member-client-role
ASTERION_ADMIN_ROLE=replace-administrator-client-role
ASTERION_ACCESS_SYNC_SECRET=replace-with-32-or-more-random-characters-for-the-loopback-sync-worker
# Optional, one-time bootstrap only. Use the verified realm subject, never email.
# ASTERION_BOOTSTRAP_ADMIN_SUB=replace-verified-owner-subject
